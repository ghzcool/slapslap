# SlapSlap environment configuration sample.
#
# Copy this file to `.env` in the project root:
#     cp .env.example .env
# (on Windows: `copy .env.example .env`)
#
# The pipeline loads `.env` automatically at startup. Values already set in the
# real environment always take precedence over values defined in `.env`.
# `.env` is gitignored; `.env.example` is committed.

# --- LLM provider ---
# 'lmstudio' (default, local server, no API key needed)
# 'openrouter' (cloud, requires OPENROUTER_API_KEY)
LLM_PROVIDER=lmstudio

# --- LM Studio (local provider) ---
LMSTUDIO_API_URL=http://localhost:1234
LM_MODEL=qwen/qwen3.6-35b-a3b
# Optional. LM Studio does not check the token by default. When omitted the
# pipeline sends "Authorization: Bearer none"; set your token here if needed.
# LM_API_TOKEN=

WHISPER_MODEL=large-v3-turbo

# --- OpenRouter (cloud provider) ---
# Required when LLM_PROVIDER=openrouter.
OPENROUTER_API_KEY=
OPENROUTER_API_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
# Optional attribution headers (HTTP-Referer / X-Title).
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=SlapSlap

# Minimum max_tokens per LLM request. Reasoning models (e.g. deepseek) need
# headroom, otherwise they spend the budget on hidden reasoning and return
# an empty answer. Raise it for very long parts.
# LLM_MIN_MAX_TOKENS=1024

# --- Compute device ('cuda' or 'cpu') ---
DEVICE=cuda

# --- TTS engine: 'voxcpm' (default) or 'qwen3' ---
TTS_METHOD=voxcpm

# --- VoxCPM2 options (all optional; leave blank to use built-in defaults) ---
VOXCPM_MODEL=
VOXCPM_DEVICE=
VOXCPM_MODE=reference
VOXCPM_CFG=2.0
VOXCPM_TIMESTEPS=10
VOXCPM_MAX_CHARS=220
VOXCPM_GAP=0.15
VOXCPM_SEED=42
VOXCPM_OPTIMIZE=true
VOXCPM_PYTHON=
